{
  "manifest_version": 3,
  "name": "Nirvana (POC)",
  "description": "A calm sidebar your agents run.",
  "version": "0.0.2",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Toggle Nirvana" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+N", "mac": "Alt+Shift+N" },
      "description": "Toggle the Nirvana sidebar"
    }
  },
  "permissions": ["sidePanel", "search"],
  "host_permissions": ["http://127.0.0.1:7777/*"]
}
